# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# --- brain-mcp HTTP transport (optional; default is stdio) ---
# BRAIN_MCP_TRANSPORT=http
# BRAIN_MCP_HOST=127.0.0.1
# BRAIN_MCP_PORT=9100

# --- OAuth auth for the public HTTP server (required behind Tailscale Funnel) ---
# A custom connector in Claude is connected server-side by Anthropic, so the
# endpoint must be public AND authenticated. brain-mcp uses a GitHub OAuth proxy
# restricted to an allowlist of GitHub logins.
# BRAIN_MCP_AUTH=github
# BRAIN_MCP_BASE_URL=https://your-host.ts.net
# BRAIN_GITHUB_CLIENT_ID=Ov23li...
# BRAIN_GITHUB_CLIENT_SECRET=...
# BRAIN_GITHUB_ALLOWED_LOGINS=your-github-login
