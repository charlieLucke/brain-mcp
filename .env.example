# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# --- brain-mcp HTTP transport (optional; default is stdio) ---
# BRAIN_MCP_TRANSPORT=http
# BRAIN_MCP_HOST=127.0.0.1
# BRAIN_MCP_PORT=9100

# --- OAuth auth for the public HTTP server (required behind Tailscale Funnel) ---
# A custom connector in Claude is connected server-side by Anthropic, so the
# endpoint must be public AND authenticated. brain-mcp uses a GitHub OAuth proxy
# restricted to an allowlist of GitHub logins.
# BRAIN_MCP_AUTH=github
# BRAIN_MCP_BASE_URL=https://your-host.ts.net
# BRAIN_GITHUB_CLIENT_ID=Ov23li...
# BRAIN_GITHUB_CLIENT_SECRET=...
# BRAIN_GITHUB_ALLOWED_LOGINS=your-github-login

# --- Read-only HTTP side for the review view (/api/vault/*) ---
# `tools/geprueft.py` answers which notes an agent wrote that nobody has read, and
# what changed in one of them since the last *human* version. Those were reachable
# only over MCP, which is the right shape for Claude and the wrong one for a
# dashboard on the same machine.
#
# The token is the gate, not a formality: caddy's default route proxies everything
# on this port through the public funnel, so these paths are publicly reachable.
# Leave it empty and the routes are not registered at all.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# BRAIN_READ_TOKEN=
